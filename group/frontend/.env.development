# Vite dev: proxy group API paths to this host. Use http:// unless 7755 really serves TLS.
# https:// on plain HTTP causes: Firefox SSL_ERROR_RX_RECORD_TOO_LONG / Node EPROTO.
#
# If npm run dev runs inside WSL and the proxy fails (ECONNREFUSED / ENOTFOUND) but Windows
# can open the same URL, set this to the controller IP or add the hostname to WSL /etc/hosts.
VITE_GROUP_BACKEND=http://yixin3-dev-ctrl001:7755
