# Backend root URL (Flask osimage), no trailing slash.
# Dev: Vite proxies http://localhost:5175/osimage-backend → this URL (no CORS).
# Prod: optional; production UI usually uses same origin and Flask-injected window.APP_URL.
#
# When the API runs on a different port than Open OnDemand (e.g. Flask :7755, OOD :8080),
# set VITE_OOD_SHELL_ORIGIN to the OOD origin so Shell/lchroot links open on the right host.
#
# Optional: full lchroot base URL (no trailing slash) if the API sends no chroot_base_url, e.g.:
# VITE_OOD_CHROOT_BASE=http://controller:8080/pun/sys/shell/ssh/controller
#
# Example:
VITE_APP_URL=http://yixin3-dev-ctrl001:7755
# VITE_OOD_SHELL_ORIGIN=http://yixin3-dev-ctrl001:8080
