# What goes into the trinityx-ood pip package. setuptools adds setup.py itself.
include requirements.txt VERSION.txt LICENSE.txt README.md

# Each app's own files: the backend, manifest.yml, requirements.txt and the like.
include */*

# Each app's page templates, and its frontend build in app/assets/ made by the
# frontend-build CI job.
graft */app

# Folders that ship with everything in them.
graft infiniband
graft osimage/addons
graft passwd
graft rack
graft slurm
graft users

# Frontend sources, earlier package builds and Python caches never ship.
prune */frontend
prune dist
global-exclude *.py[cod]
