# Vite dev: proxy /node-backend to this URL. Prefer http:// unless 7755 really serves TLS (else SSL_ERROR_RX_RECORD_TOO_LONG).
#
# Local: run the Flask node app on :7755, or point at the controller host. If npm run dev is in WSL and the proxy fails
# (ECONNREFUSED / ENOTFOUND) but Windows can open the URL, set the controller IP or add hostname in WSL /etc/hosts.

# Proxy target must be a URL (not a filesystem path).

VITE_NODE_BACKEND=http://yixin3-dev-ctrl001:7755
