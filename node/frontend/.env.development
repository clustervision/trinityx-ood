# Proxy target must be a URL (not a filesystem path).
# Local: from repo ../trinityx-ood/node run the Flask app (port 7755, HTTP), then:
VITE_NODE_BACKEND=http://127.0.0.1:7755

# If the API runs on another machine instead, use that host (usually http://...:7755 unless you really use TLS):
# VITE_NODE_BACKEND=http://yixin3-dev-ctrl001:7755
